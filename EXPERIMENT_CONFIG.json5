{
    // Location of the ns-3 checkout (~1.5 GB, installed separately -- see the
    // README). Must be the zenoh-experiment branch with contrib/nr at b1bedf07,
    // built with -d optimized. Verify with ./check_ns3.sh. "~" is expanded.
    "ns3_dir": "~/dev/ns-3-dev",

    // Optional override for the zenoh checkout location. By default the config
    // mounts the in-repo submodule ("zenoh/target/.../release"). Uncomment this
    // to point at a clone that lives outside the repo -- its leading "zenoh"
    // component is swapped for this path. Omit the field entirely to keep the
    // default (in-repo) behaviour. "~" is expanded.
    // "zenoh_dir": "~/dev/zenoh",

    // Number of experiment rounds to run
    "rounds": 10,

    // Max seconds to wait for launch_nodes.py's readiness marker before
    // aborting the round (actual wait is usually much shorter — ns-3
    // starts as soon as all containers/TAP devices are confirmed ready)
    "launch_wait": 45,

    // Pause between consecutive rounds (seconds)
    "round_pause": 5,

    // ns-3 simulation parameters for nr-mec-3gpp-calibration
    // simTime is also used to compute launch_nodes.py -t (simTime + 20)
    "ns3": {
        // TAP bridge
        "enableTap": true,

        // Mobility
        "mobilityModel": "waypoint",
        "builtinPath": "highway",
        "mobilityStartDelay": 10,

        // NR (5G)
        "bandwidth": 20e6,

        // Simulation time (seconds)
        "simTime": 60,

        // Output directory (relative to ~/dev/ns-3-dev)
        "experimentDir": "latency/highway/presub",

        // Cell load / background traffic
        // "numBgUes": 1,
        // "bgTrafficMbps": 5,
        // "bgTargetGnbs": "5,0,2",
        // "loadPercent": 0
    },

    // Optional: run several settings sequentially. When this array is present
    // and non-empty, the top-level "ns3"/"rounds" block above is ignored and
    // each entry below is run in order (all "rounds" rounds of setting 1, then
    // setting 2, ...). "ns3_dir"/"zenoh_dir" stay global -- they are checkout
    // locations, not experiment parameters -- so they are not repeated here.
    //
    // Each entry is fully self-contained. "rounds"/"launch_wait"/"round_pause"
    // fall back to the top-level values (then built-in defaults) when omitted.
    // "networkConfig" falls back to the -n CLI flag, then launch_nodes.py's own
    // default. A failed round skips the rest of that setting and moves on to the
    // next; the run exits non-zero if any setting failed.
    "settings": [
        {
            "name": "presub-highway",
            "networkConfig": "configs/pre-subscribe.json5",
            "rounds": 10,
            "ns3": {
                "enableTap": true,
                "mobilityModel": "waypoint",
                "builtinPath": "highway",
                "mobilityStartDelay": 10,
                "bandwidth": 20e6,
                "simTime": 60,
                "experimentDir": "latency/highway/presub"
            }
        },
        {
            "name": "baseline-highway",
            "networkConfig": "configs/ablation-baseline.json5",
            "rounds": 10,
            "ns3": {
                "enableTap": true,
                "mobilityModel": "waypoint",
                "builtinPath": "highway",
                "mobilityStartDelay": 10,
                "bandwidth": 20e6,
                "simTime": 60,
                "experimentDir": "latency/highway/baseline"
            }
        },
        {
            "name": "presub-lcorner",
            "networkConfig": "configs/pre-subscribe.json5",
            "rounds": 10,
            "ns3": {
                "enableTap": true,
                "mobilityModel": "waypoint",
                "builtinPath": "l-corner",
                "mobilityStartDelay": 10,
                "bandwidth": 20e6,
                "simTime": 100,
                "experimentDir": "latency/lcorner/presub"
            }
        },
        {
            "name": "baseline-lcorner",
            "networkConfig": "configs/ablation-baseline.json5",
            "rounds": 10,
            "ns3": {
                "enableTap": true,
                "mobilityModel": "waypoint",
                "builtinPath": "l-corner",
                "mobilityStartDelay": 10,
                "bandwidth": 20e6,
                "simTime": 100,
                "experimentDir": "latency/lcorner/baseline"
            }
        },
        {
            "name": "presub-ucorner",
            "networkConfig": "configs/pre-subscribe.json5",
            "rounds": 10,
            "ns3": {
                "enableTap": true,
                "mobilityModel": "waypoint",
                "builtinPath": "u-corner",
                "mobilityStartDelay": 10,
                "bandwidth": 20e6,
                "simTime": 100,
                "experimentDir": "latency/ucorner/presub"
            }
        },
        {
            "name": "baseline-ucorner",
            "networkConfig": "configs/ablation-baseline.json5",
            "rounds": 10,
            "ns3": {
                "enableTap": true,
                "mobilityModel": "waypoint",
                "builtinPath": "u-corner",
                "mobilityStartDelay": 10,
                "bandwidth": 20e6,
                "simTime": 100,
                "experimentDir": "latency/ucorner/baseline"
            }
        },
        {
            "name": "bg-presub-highway",
            "networkConfig": "configs/pre-subscribe.json5",
            "rounds": 10,
            "ns3": {
                "enableTap": true,
                "mobilityModel": "waypoint",
                "builtinPath": "highway",
                "mobilityStartDelay": 10,
                "bandwidth": 20e6,
                "simTime": 60,
                "numBgUes": 1,
                "bgTrafficMbps": 5,
                "bgTargetGnbs": "5,0,2",
                "experimentDir": "latency/bg-highway/presub"
            }
        },
        {
            "name": "bg-baseline-highway",
            "networkConfig": "configs/ablation-baseline.json5",
            "rounds": 10,
            "ns3": {
                "enableTap": true,
                "mobilityModel": "waypoint",
                "builtinPath": "highway",
                "mobilityStartDelay": 10,
                "bandwidth": 20e6,
                "simTime": 60,
                "numBgUes": 1,
                "bgTrafficMbps": 5,
                "bgTargetGnbs": "5,0,2",
                "experimentDir": "latency/bg-highway/baseline"
            }
        },
        {
            "name": "bg-presub-lcorner",
            "networkConfig": "configs/pre-subscribe.json5",
            "rounds": 10,
            "ns3": {
                "enableTap": true,
                "mobilityModel": "waypoint",
                "builtinPath": "l-corner",
                "mobilityStartDelay": 10,
                "bandwidth": 20e6,
                "simTime": 100,
                "numBgUes": 1,
                "bgTrafficMbps": 5,
                "bgTargetGnbs": "0,1,2",
                "experimentDir": "latency/bg-lcorner/presub"
            }
        },
        {
            "name": "bg-baseline-lcorner",
            "networkConfig": "configs/ablation-baseline.json5",
            "rounds": 10,
            "ns3": {
                "enableTap": true,
                "mobilityModel": "waypoint",
                "builtinPath": "l-corner",
                "mobilityStartDelay": 10,
                "bandwidth": 20e6,
                "simTime": 100,
                "numBgUes": 1,
                "bgTrafficMbps": 5,
                "bgTargetGnbs": "0,1,2",
                "experimentDir": "latency/bg-lcorner/baseline"
            }
        },
        {
            "name": "bg-presub-ucorner",
            "networkConfig": "configs/pre-subscribe.json5",
            "rounds": 10,
            "ns3": {
                "enableTap": true,
                "mobilityModel": "waypoint",
                "builtinPath": "u-corner",
                "mobilityStartDelay": 10,
                "bandwidth": 20e6,
                "simTime": 100,
                "numBgUes": 1,
                "bgTrafficMbps": 5,
                "bgTargetGnbs": "0,2,6",
                "experimentDir": "latency/bg-ucorner/presub"
            }
        },
        {
            "name": "bg-baseline-ucorner",
            "networkConfig": "configs/ablation-baseline.json5",
            "rounds": 10,
            "ns3": {
                "enableTap": true,
                "mobilityModel": "waypoint",
                "builtinPath": "u-corner",
                "mobilityStartDelay": 10,
                "bandwidth": 20e6,
                "simTime": 100,
                "numBgUes": 1,
                "bgTrafficMbps": 5,
                "bgTargetGnbs": "0,2,6",
                "experimentDir": "latency/bg-ucorner/baseline"
            }
        },
    ]
}
