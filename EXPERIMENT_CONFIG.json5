{
    // Location of the ns-3 checkout (~1.5 GB, installed separately -- see the
    // README). Must be the zenoh-experiment branch with contrib/nr at b1bedf07,
    // built with -d optimized. Verify with ./check_ns3.sh. "~" is expanded.
    "ns3_dir": "~/dev/ns-3-dev",

    // Optional override for the zenoh checkout location. By default the config
    // mounts the in-repo submodule ("zenoh/target/.../release"). Uncomment this
    // to point at a clone that lives outside the repo -- its leading "zenoh"
    // component is swapped for this path. Omit the field entirely to keep the
    // default (in-repo) behaviour. "~" is expanded.
    // "zenoh_dir": "~/dev/zenoh",

    // Number of experiment rounds to run
    "rounds": 10,

    // Max seconds to wait for launch_nodes.py's readiness marker before
    // aborting the round (actual wait is usually much shorter — ns-3
    // starts as soon as all containers/TAP devices are confirmed ready)
    "launch_wait": 45,

    // Pause between consecutive rounds (seconds)
    "round_pause": 5,

    // ns-3 simulation parameters for nr-mec-3gpp-calibration
    // simTime is also used to compute launch_nodes.py -t (simTime + 20)
    "ns3": {
        // TAP bridge
        "enableTap": true,

        // Mobility
        "mobilityModel": "waypoint",
        "builtinPath": "highway",
        "mobilityStartDelay": 10,

        // NR (5G)
        "bandwidth": 20e6,

        // Simulation time (seconds)
        "simTime": 60,

        // Output directory (relative to ~/dev/ns-3-dev)
        "experimentDir": "latency/highway/presub",

        // Cell load / background traffic
        // "numBgUes": 1,
        // "bgTrafficMbps": 5,
        // "bgTargetGnbs": "5,0,2",
        // "loadPercent": 0
    }
}
